            "value": "Date"
          }
        }
      }
    },
    "締め日時が過去になっています。未来の日時を選んでください。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This date and time has already passed. Choose one in the future."
          }
        }
      }
    },
    "締め日時を過ぎるとカウントを終了します。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The countdown ends when this date and time passes."
          }
        }
      }
    },
    "締め時刻": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deadline"
          }
        }
      }
    },
    "締め時刻までの残り時間を、分または秒で表示します。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows the time left until your deadline, in minutes or seconds."
          }
        }
      }
    },
    "締め時刻までの残り時間を表示します。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows the time left until your deadline."
          }
        }
      }
    },
    "締め時刻を過ぎると、翌日の同じ時刻までのカウントを自動で始めます。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When the deadline passes, the countdown automatically restarts toward the same time the next day."
          }
        }
      }
    },
